# RetailScan AI — Environment Configuration
# Copy this file to .env and fill in your actual values
# .env is gitignored — NEVER commit the real .env file

# ── Flask ──────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-here

# ── Google Gemini AI ───────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_FALLBACK=your-fallback-gemini-key-here

# ── Firebase ───────────────────────────────────────────────────
# These are public values (safe in source); override here if needed
# FIREBASE_PROJECT_ID=smartcart-6de46
# FIREBASE_WEB_API_KEY=AIzaSyDQ_EfOL_VR8mSVtd21DB0WK7-2RBnyJS8

# ── SMTP Email ─────────────────────────────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-here

# ── App Mode ───────────────────────────────────────────────────
# Set FLASK_ENV=production for deployment
FLASK_ENV=development
DEBUG=true
